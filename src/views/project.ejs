        // Format file size
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        // Process Factiva PDF
        async function processFactivaPDF() {
            console.log('Process PDF button clicked');
            console.log('Selected file:', factivaSelectedFile);
            
            if (!factivaSelectedFile) {
                console.log('No file selected, returning');
                showFactivaError('Please select a PDF file first.');
                return;
            }

            try {
                console.log('Starting PDF processing...');
                
                // Check if PDF.js is available
                if (typeof pdfjsLib === 'undefined') {
                    throw new Error('PDF.js library not loaded. Please refresh the page.');
                }
                
                showFactivaLoading();
                hideFactivaError();
                hideFactivaStats();

                const arrayBuffer = await readFileAsArrayBuffer(factivaSelectedFile);
                console.log('File read as ArrayBuffer, size:', arrayBuffer.byteLength);
                
                const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
                console.log('PDF document loaded, pages:', pdf.numPages);
                
                const result = {
                    metadata: {
                        filename: factivaSelectedFile.name,
                        filesize: factivaSelectedFile.size,
                        pageCount: pdf.numPages,
                        conversionDate: new Date().toISOString()
                    },
                    pages: []
                };

                let totalWords = 0;
                let totalChars = 0;

                // Process each page
                for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
                    updateFactivaProgress((pageNum / pdf.numPages) * 100);
                    
                    const page = await pdf.getPage(pageNum);
                    const textContent = await page.getTextContent();
                    
                    let pageText = '';
                    let lastY = null;
                    let lineHeight = 0;
                    
                    // Calculate average line height from first few text items
                    if (textContent.items.length > 0) {
                        const firstItems = textContent.items.slice(0, Math.min(10, textContent.items.length));
                        const heights = firstItems.map(item => item.height || 0).filter(h => h > 0);
                        if (heights.length > 0) {
                            lineHeight = heights.reduce((a, b) => a + b, 0) / heights.length;
                        }
                    }
                    
                    textContent.items.forEach((item, index) => {
                        const currentY = item.transform[5]; // Y position from transform matrix
                        
                        // Add line break if Y position changed significantly (indicating new line)
                        if (lastY !== null && Math.abs(currentY - lastY) > lineHeight * 0.5) {
                            pageText += '\n';
                        }
                        
                        // Add the text
                        pageText += item.str;
                        
                        // Update last Y position
                        lastY = currentY;
                    });

                    const pageData = {
                        pageNumber: pageNum,
                        text: pageText.trim(),
                        wordCount: pageText.trim().split(/\s+/).filter(word => word.length > 0).length,
                        characterCount: pageText.trim().length
                    };

                    result.pages.push(pageData);
                    totalWords += pageData.wordCount;
                    totalChars += pageData.characterCount;
                }

                // Extract articles from the index
                const articles = extractFactivaArticlesFromIndex(result.pages);
                
                factivaArticlesData = {
                    metadata: result.metadata,
                    articles: articles,
                    summary: {
                        totalArticles: articles.length,
                        totalWords: totalWords,
                        totalCharacters: totalChars,
                        articlesWithText: articles.filter(a => a.textContent).length
                    }
                };

                // Display results
                showFactivaStats(articles.length, pdf.numPages, totalWords);
                hideFactivaLoading();
                hideFactivaProgress();

                // Write articles to sheet
                await writeFactivaArticlesToSheet(articles);

            } catch (err) {
                console.error('Error processing PDF:', err);
                console.error('Error details:', {
                    name: err.name,
                    message: err.message,
                    stack: err.stack
                });
                showFactivaError('Error processing PDF: ' + err.message);
                hideFactivaLoading();
                hideFactivaProgress();
            }
        }

        // Extract articles from Factiva PDF index pages
        function extractFactivaArticlesFromIndex(pages) {
            let articles = [];
            
            // Look for index pages (pages with article titles and page numbers)
            for (let i = 0; i < Math.min(10, pages.length); i++) {
                const page = pages[i];
                const text = page.text;
                
                // Check if this page contains article listings with page numbers
                if (isFactivaIndexPage(text)) {
                    const pageArticles = parseFactivaIndexPage(text, page.pageNumber);
                    articles.push(...pageArticles);
                }
            }

            // If no index pages found, try to identify articles by looking for patterns
            if (articles.length === 0) {
                articles.push(...extractFactivaArticlesByPattern(pages));
            }

            // Extract text content for each article
            if (articles.length > 0) {
                articles.forEach((article, index) => {
                    article.textContent = extractFactivaArticleText(article, pages, articles, index);
                    
                    // Extract metadata from the text content
                    if (article.textContent) {
                        const metadata = extractFactivaArticleMetadata(article.textContent, article.title);
                        Object.assign(article, metadata);
                    }
                });
            }

            return articles;
        }

        // Check if a page is a Factiva index page
        function isFactivaIndexPage(text) {
            // Look for multiple patterns that indicate this is an index page
            const dotPattern = /[A-Z][A-Z\s]+\.{3,}\s+\d+/g;
            const dotMatches = text.match(dotPattern);
            
            const titlePagePattern = /[A-Z][A-Z\s]+\s+\d+/g;
            const titlePageMatches = text.match(titlePagePattern);
            
            const pageNumbers = text.match(/\d+/g);
            const uniquePageNumbers = [...new Set(pageNumbers)].map(n => parseInt(n)).sort((a, b) => a - b);
            
            const hasMultipleArticles = (dotMatches && dotMatches.length >= 2) || 
                                     (titlePageMatches && titlePageMatches.length >= 2);
            
            const hasReasonablePageNumbers = uniquePageNumbers.length >= 2 && 
                                           uniquePageNumbers.every((num, i) => i === 0 || num > uniquePageNumbers[i-1]);
            
            return hasMultipleArticles || hasReasonablePageNumbers;
        }

        // Parse Factiva index page to extract articles
        function parseFactivaIndexPage(text, pageNumber) {
            const articles = [];
            
            // Filter out header text
            let cleanText = text;
            cleanText = cleanText.replace(/Page \d+ of \d+\s*© \d+ Factiva, Inc\. All rights reserved\./g, '');
            cleanText = cleanText.replace(/Page \d+ of \d+/g, '');
            cleanText = cleanText.replace(/© \d+ Factiva, Inc\. All rights reserved\./g, '');
            
            // Find all page numbers in the text
            const pageNumbers = [];
            
            // Primary pattern: Look for numbers that are preceded by dots
            const dotPagePattern = /\.{2,}\s*(\d+)/g;
            let dotMatch;
            
            while ((dotMatch = dotPagePattern.exec(cleanText)) !== null) {
                const pageNum = parseInt(dotMatch[1]);
                if (pageNum > 1 && pageNum < 500) {
                    pageNumbers.push({
                        number: pageNum,
                        index: dotMatch.index + dotMatch[0].length - pageNum.toString().length
                    });
                }
            }
            
            // Sort page numbers by their position in the text
            pageNumbers.sort((a, b) => a.index - b.index);
            
            // Extract text before each page number as potential article titles
            for (let i = 0; i < pageNumbers.length; i++) {
                const currentPage = pageNumbers[i];
                
                let startIndex = 0;
                if (i > 0) {
                    const previousPage = pageNumbers[i - 1];
                    startIndex = previousPage.index + previousPage.number.toString().length;
                }
                
                const endIndex = currentPage.index;
                
                if (endIndex > startIndex) {
                    const textSegment = cleanText.substring(startIndex, endIndex).trim();
                    
                    let cleanTitle = textSegment
                        .replace(/\.{3,}/g, ' ')
                        .replace(/\s+/g, ' ')
                        .trim();
                    
                    if (cleanTitle.length >= 5 && isValidFactivaArticleTitle(cleanTitle, currentPage.number)) {
                        articles.push({
                            title: cleanTitle,
                            pageNumber: currentPage.number,
                            indexPage: pageNumber
                        });
                    }
                }
            }
            
            return articles;
        }

        // Validate article title
        function isValidFactivaArticleTitle(title, pageNum) {
            if (!title || !pageNum) return false;
            if (title.length < 3) return false;
            if (pageNum < 1 || pageNum > 1000) return false;
            
            const invalidPatterns = ['Page', 'Factiva', 'Inc', 'All rights reserved', '©', 'Document', 'Unknown', 'Dow Jones'];
            for (const pattern of invalidPatterns) {
                if (title.includes(pattern)) return false;
            }
            
            const letterCount = (title.match(/[A-Za-z]/g) || []).length;
            if (letterCount === 0) return false;
            if (letterCount / title.length < 0.1) return false;
            
            return true;
        }

        // Extract text content for a specific article
        function extractFactivaArticleText(article, pages, allArticles, currentIndex) {
            const startPage = article.pageNumber;
            let endPage = startPage;
            
            // Find the next article's page number to determine where this article ends
            const nextArticle = allArticles.find((a, index) => index > currentIndex && a.pageNumber > startPage);
            if (nextArticle) {
                endPage = nextArticle.pageNumber - 1;
            } else {
                endPage = pages.length;
            }
            
            let articleText = '';
            
            // Extract text from each page in the range
            for (let pageNum = startPage; pageNum <= endPage; pageNum++) {
                const page = pages.find(p => p.pageNumber === pageNum);
                if (page) {
                    if (pageNum > startPage) {
                        articleText += '\n\n--- Page ' + pageNum + ' ---\n\n';
                    }
                    articleText += page.text;
                }
            }
            
            return articleText.trim();
        }

        // Extract article metadata
        function extractFactivaArticleMetadata(articleText, articleTitle) {
            const metadata = {
                wordCount: null,
                publishDate: null,
                author: null,
                source: null
            };
            
            if (!articleText || articleText.length === 0) {
                return metadata;
            }
            
            const lines = articleText.split('\n').map(line => line.trim()).filter(line => line.length > 0);
            
            // Look for word count and date pattern in the first few lines
            for (let i = 0; i < Math.min(20, lines.length); i++) {
                const line = lines[i];
                
                const wordCountPattern = /^(\d{1,3}(?:,\d{3})*)\s+words$/i;
                const wordCountMatch = line.match(wordCountPattern);
                
                if (wordCountMatch) {
                    const wordCountStr = wordCountMatch[1].replace(/,/g, '');
                    metadata.wordCount = parseInt(wordCountStr);
                    
                    if (i + 1 < lines.length) {
                        const nextLine = lines[i + 1].trim();
                        metadata.publishDate = parseFactivaDate(nextLine);
                        
                        if (i + 2 < lines.length) {
                            const lineAfterDate = lines[i + 2].trim();
                            
                            const timePattern = /^\d{1,2}:\d{2}\s*(AM|PM|am|pm)?$/;
                            const isTimeLine = timePattern.test(lineAfterDate);
                            
                            if (isTimeLine) {
                                if (i + 3 < lines.length) {
                                    const sourceLine = lines[i + 3].trim();
                                    if (sourceLine.length > 0 && isValidFactivaSourceName(sourceLine)) {
                                        metadata.source = sourceLine;
                                    }
                                }
                            } else {
                                if (lineAfterDate.length > 0 && isValidFactivaSourceName(lineAfterDate)) {
                                    metadata.source = lineAfterDate;
                                }
                            }
                        }
                    }
                    
                    // Look for author above word count line
                    if (i > 0) {
                        const lineAboveWordCount = lines[i - 1].trim();
                        if (lineAboveWordCount.length > 0 && !isCommonFactivaNonAuthorText(lineAboveWordCount)) {
                            metadata.author = lineAboveWordCount;
                        }
                    }
                    
                    break;
                }
            }
            
            return metadata;
        }

        // Parse date from various formats
        function parseFactivaDate(dateText) {
            const datePatterns = [
                /^(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})$/,
                /^([A-Za-z]+)\s+(\d{1,2}),?\s+(\d{4})$/,
                /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/,
                /^(\d{4})-(\d{1,2})-(\d{1,2})$/
            ];
            
            for (const pattern of datePatterns) {
                const match = dateText.match(pattern);
                if (match) {
                    try {
                        if (pattern.source.includes('[A-Za-z]+')) {
                            const day = parseInt(match[1]);
                            const month = match[2];
                            const year = parseInt(match[3]);
                            
                            const monthNames = [
                                'january', 'february', 'march', 'april', 'may', 'june',
                                'july', 'august', 'september', 'october', 'november', 'december'
                            ];
                            const monthIndex = monthNames.indexOf(month.toLowerCase());
                            
                            if (monthIndex !== -1) {
                                const date = new Date(year, monthIndex, day);
                                if (!isNaN(date.getTime())) {
                                    return date.toISOString().split('T')[0];
                                }
                            }
                        } else {
                            const parts = match.slice(1).map(Number);
                            let date;
                            
                            if (pattern.source.includes('\\d{4}-')) {
                                date = new Date(parts[0], parts[1] - 1, parts[2]);
                            } else {
                                date = new Date(parts[2], parts[0] - 1, parts[1]);
                            }
                            
                            if (!isNaN(date.getTime())) {
                                return date.toISOString().split('T')[0];
                            }
                        }
                    } catch (error) {
                        console.warn('Error parsing date:', dateText, error);
                    }
                }
            }
            
            return dateText;
        }

        // Check if text is likely not an author name
        function isCommonFactivaNonAuthorText(text) {
            const nonAuthorPatterns = [
                /^page\s+\d+/i,
                /^©\s*\d{4}/i,
                /^factiva/i,
                /^all\s+rights\s+reserved/i,
                /^\d+$/,
                /^\s*$/,
                /^volume\s+\d+/i,
                /^issue\s+\d+/i,
                /^document\s+\d+/i
            ];
            
            return nonAuthorPatterns.some(pattern => pattern.test(text));
        }

        // Check if text is likely a valid source name
        function isValidFactivaSourceName(text) {
            if (!text || text.length < 3) return false;
            
            const letterCount = (text.match(/[A-Za-z]/g) || []).length;
            if (letterCount < 2) return false;
            
            if (/^\d{1,2}:\d{2}\s*(AM|PM|am|pm)?$/i.test(text)) return false;
            if (/^\d+$/.test(text)) return false;
            
            return true;
        }

        // Extract articles by pattern if no index is found
        function extractFactivaArticlesByPattern(pages) {
            const articles = [];
            
            for (const page of pages) {
                const text = page.text;
                
                // Look for article headers (titles in all caps, followed by author info)
                const articleMatches = text.match(/[A-Z][A-Z\s]+(?:\s+[A-Z][a-z]+\s+\d+,\d+\s+words)/g);
                
                if (articleMatches) {
                    for (const match of articleMatches) {
                        const title = match.split(/\s+\d+,\d+\s+words/)[0].trim();
                        if (title.length > 10) {
                            articles.push({
                                title: title,
                                pageNumber: page.pageNumber,
                                indexPage: null
                            });
                        }
                    }
                }
            }
            
            return articles;
        }

        // Write Factiva articles to sheet
        async function writeFactivaArticlesToSheet(articles) {
            if (!articles || articles.length === 0) {
                showFactivaError('No articles to write to sheet.');
                return;
            }

            try {
                // Format articles for the API
                const formattedArticles = articles.map(article => ({
                    source: article.source || 'Factiva',
                    title: article.title || 'No Title',
                    authors: article.author || 'No Author Available',
                    url: '', // Factiva articles don't have URLs
                    content: article.textContent || 'No Content Available',
                    date: article.publishDate || new Date().toISOString().split('T')[0],
                    inputMethod: 'Factiva PDF'
                }));

                const res = await fetch('/api/event-registry/write-to-sheet', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        projectId: '<%= project.id %>',
                        articles: formattedArticles
                    })
                });

                if (res.ok) {
                    const data = await res.json();
                    showFactivaSuccess(`Successfully processed and added ${articles.length} articles from Factiva PDF!`);
                    setTimeout(() => {
                        location.reload();
                    }, 2000);
                } else {
                    const errorData = await res.json();
                    showFactivaError(`Failed to write articles to sheet: ${errorData.message || 'Unknown error'}`);
                }
            } catch (error) {
                showFactivaError(`Failed to write articles to sheet: ${error.message}`);
            }
        }

        // Utility functions
        function readFileAsArrayBuffer(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result);
                reader.onerror = reject;
                reader.readAsArrayBuffer(file);
            });
        }

        function updateFactivaProgress(percentage) {
            document.getElementById('factivaProgressFill').style.width = percentage + '%';
        }

        function showFactivaLoading() {
            document.getElementById('factivaLoading').classList.add('show');
            document.getElementById('factivaProcessBtn').disabled = true;
        }

        function hideFactivaLoading() {
            document.getElementById('factivaLoading').classList.remove('show');
            document.getElementById('factivaProcessBtn').disabled = false;
        }

        function showFactivaProgress() {
            document.getElementById('factivaProgressBar').classList.add('show');
        }

        function hideFactivaProgress() {
            document.getElementById('factivaProgressBar').classList.remove('show');
            document.getElementById('factivaProgressFill').style.width = '0%';
        }

        function showFactivaError(message) {
            const errorEl = document.getElementById('factivaError');
            errorEl.textContent = message;
            errorEl.classList.add('show');
        }

        function hideFactivaError() {
            document.getElementById('factivaError').classList.remove('show');
        }

        function showFactivaStats(articleCount, pageCount, totalWords) {
            document.getElementById('factivaPageCount').textContent = pageCount;
            document.getElementById('factivaArticleCount').textContent = articleCount;
            document.getElementById('factivaWordCount').textContent = totalWords.toLocaleString();
            document.getElementById('factivaStats').classList.add('show');
        }

        function hideFactivaStats() {
            document.getElementById('factivaStats').classList.remove('show');
        }

        function showFactivaSuccess(message) {
            // Create a temporary success message
            const successDiv = document.createElement('div');
            successDiv.className = 'success-message';
            successDiv.style.cssText = `
                background: #d4edda;
                color: #155724;
                border: 1px solid #c3e6cb;
                border-radius: 8px;
                padding: 12px;
                margin: 15px 0;
                font-weight: 500;
            `;
            successDiv.textContent = message;
            
            const factivaPanel = document.getElementById('factivaPanel');
            factivaPanel.insertBefore(successDiv, factivaPanel.firstChild);
            
            // Remove after 5 seconds
            setTimeout(() => {
                if (successDiv.parentNode) {
                    successDiv.parentNode.removeChild(successDiv);
                }
            }, 5000);
        }

        function clearFactivaData() {
            factivaSelectedFile = null;
            factivaArticlesData = null;
            document.getElementById('factivaFileInput').value = '';
            document.getElementById('factivaFileInfo').classList.remove('show');
            document.getElementById('factivaStats').classList.remove('show');
            document.getElementById('factivaProcessBtn').disabled = true;
            hideFactivaError();
            hideFactivaLoading();
            hideFactivaProgress();
        }
    </script>
</body>
</html>
