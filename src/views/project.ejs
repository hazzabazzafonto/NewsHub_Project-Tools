        // Initialize Factiva PDF functionality - moved to main DOMContentLoaded

        function initializeFactivaPDF() {
            console.log('Initializing Factiva PDF functionality...');
            
            const uploadArea = document.getElementById('factivaUploadArea');
            const fileInput = document.getElementById('factivaFileInput');
            const processBtn = document.getElementById('factivaProcessBtn');
            const clearBtn = document.getElementById('factivaClearBtn');

            console.log('Elements found:', {
                uploadArea: !!uploadArea,
                fileInput: !!fileInput,
                processBtn: !!processBtn,
                clearBtn: !!clearBtn
            });

